# ==============================================================================
# PRTS Story Terminal - Git Exclusion Rules (.gitignore)
# ==============================================================================

# 1. Logs & Process IDs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.prts_server.log
.prts_server.pid

# 2. Build Artifacts, Dependencies & Environment Variables
node_modules/
dist/
dist-ssr/
*.local
.env*

# 3. Editor & OS Artifacts
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# 4. AI Internal Prompts, Working Design Docs & Agent Metas
docs/
STORY_AUTHORING_PIPELINE.md
STORY_ARCHIVE_PROMPT_TEMPLATE.md
KR_CANON_GLOSSARY.md
VISUAL_RESOURCE_CATALOG.md
TERRA_TACTICAL_MAP_SPEC.md
PRTS_Story_Archive_Status_Master.md
[PRTS]_*.md
PRTS_*.md
exports/
.cursor*
.antigravity*
.gemini*
CLAUDE.md
AGENTS.md

# 5. Raw Game Dumps, Scraped Scripts & Master Resource Pools (NEVER COMMIT)
raw_data/
raw_resources/
assets_source/
library/

# Local Character CG Master Library (Crawler Cache: ~4,000 files, ~2.8GB)
public/images/characters/library/
public/images/characters/illust_legacy_backup/

# 6. Safety Barrier: Prevent Raw Datamined Files from Leaking into Production
public/images/characters/illust/avg_*
public/images/characters/illust/char_*

# 7. Local Tooling Scripts & Temporary Workspace Dumps
scripts/*
!scripts/validate_stories.cjs
!scripts/import_character_asset.cjs
*.py
*.pyc
*.npy
__pycache__/
archive_screenshots/
파일 첨부/
scratch/
scratch_*.png
npc_mapping_result.txt
PRTS_Terminal.bat
